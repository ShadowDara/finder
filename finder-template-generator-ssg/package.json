{
  "name": "finder-template-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode backend",
    "build": "node prebuild.js && tsc -b && vite build --mode backend && node postbuild.js",
    "tbuild": "tsc -b && vite build --mode backend",
    "preview": "vite preview --mode backend",
    "dev:static": "vite --mode static",
    "build:static": "node prebuild.js && tsc -b && vite build --mode static",
    "tbuild:static": "tsc -b && vite build --mode static",
    "previwq:static": "vite preview --mode static",
    "bb": "npm run build && npm run build:static",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "html-minifier-terser": "^7.2.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@shadowdara/dlib": "^0.0.3"
  }
}

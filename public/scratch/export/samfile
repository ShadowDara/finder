# Make the webbuild
webbuild:
    echo INFO
    echo you need to have emscripten installed for that!
    echo
    echo ==========================================
    echo Delete old build!
    echo ==========================================
    RM webbuild

    echo
    echo ==========================================
    echo Configure CMAKE project with emcmake ...
    echo ==========================================
    SHELL emcmake cmake -B webbuild

    echo
    echo ==========================================
    echo Build Project...
    echo ==========================================
    SHELL emmake cmake --build webbuild -j

    echo
    echo ==========================================
    echo Finished!
    echo ==========================================

    PROMPT

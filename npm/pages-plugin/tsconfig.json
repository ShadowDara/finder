{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": false,
        "sourceMap": false,
        "module": "ESNext",
        "target": "ES2020",
        "moduleResolution": "Bundler",
        "types": [
            "node",
            "vite/client"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "lib": [
            "ES2021",
            "DOM"
        ]
    },
    "include": [
        "src",
        "../site/src/jsx.d.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.test.ts"
    ]
}